# Configuración de la Audioteca. `./setup.sh` la copia a `.env`; edita `.env`, no este archivo.
# Las rutas relativas son relativas a la carpeta del repo. `~` funciona como tu carpeta personal.

# ── Carpetas ───────────────────────────────────────────────────────────────
# Donde viven tus libros ya procesados (texto, audio, libro.json). Nunca se sube a git.
AUDIOTECA_LIBROS=biblioteca
# Referencias de voz para clonar: <nombre>.wav + <nombre>.txt → voz «<nombre>-clon».
AUDIOTECA_VOCES=voces
# Cola del narrador, caché del traductor y logs.
AUDIOTECA_TRABAJO=.trabajo
# Estado de la app: firma de las sesiones y respaldo del progreso de escucha.
AUDIOTECA_DATOS=.data

# ── App (servidor para el iPhone) ─────────────────────────────────────────
AUDIOTECA_PUERTO=3410
# 0.0.0.0 = visible en tu red local (el iPhone entra por http://<ip-de-tu-mac>:3410/).
# 127.0.0.1 = solo este Mac (úsalo si la publicas con un proxy como Tailscale Serve o Caddy).
AUDIOTECA_HOST=0.0.0.0
# Contraseña para entrar desde el teléfono. Vacía = sin contraseña (cualquiera en tu Wi-Fi puede entrar).
AUDIOTECA_CONTRASENA=
# Si la app vive bajo una ruta detrás de un proxy (p. ej. /audioteca). Vacío = en la raíz.
AUDIOTECA_PREFIJO=
# HTTPS propio (opcional; necesario para descargas offline si no usas un proxy con HTTPS). Ver README.
AUDIOTECA_TLS_CERT=
AUDIOTECA_TLS_KEY=
# Cookie solo por HTTPS. Vacío = automático (sí con TLS propio). Pon 1 si un proxy te da HTTPS.
AUDIOTECA_COOKIE_SEGURA=

# ── Narrador ───────────────────────────────────────────────────────────────
# Voz de los libros nuevos: macos (say, instantánea), qwen-clon (genérica de Qwen) o <tu-voz>-clon.
AUDIOTECA_VOZ=macos
# Voz de `say` en español. Vacío = la primera instalada (Paulina, Mónica…). Lista: say -v '?' | grep es_
AUDIOTECA_VOZ_MACOS=
# Palabras por minuto de la voz de macOS.
AUDIOTECA_RITMO_MACOS=180
# Modelo de voz (Hugging Face, MLX).
AUDIOTECA_MODELO_TTS=mlx-community/Qwen3-TTS-12Hz-0.6B-Base-8bit
# Voz que la app pone por omisión si la tiene narrada al menos tanto como la voz del libro (p. ej. tu-voz-clon).
# Vacío = la voz del libro. Elegir otra en el engrane del libro siempre manda.
AUDIOTECA_VOZ_PREFERIDA=
# Trabajadores en paralelo (cada uno carga su modelo; 1 basta, 2 si tienes 32 GB o más).
AUDIOTECA_PROCESOS=1

# ── Traductor ──────────────────────────────────────────────────────────────
# gemma4-12b (7.5 GB, defecto) · gemma4-12b-qat (11 GB, algo mejor) · tgemma-12b · tgemma-4b (más ligero)
AUDIOTECA_MOTOR_TRADUCCION=gemma4-12b
